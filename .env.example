# ═══════════════════════════════════════════════════════════════════
# AC-RMS — Cấu hình Biến môi trường (Local & Render Cloud Deployment)
# ═══════════════════════════════════════════════════════════════════

PORT=4000
NODE_ENV=development

# Cách 1 (Khuyên dùng cho Aiven Free MySQL / TiDB Cloud Serverless / Railway):
# Dán trực tiếp Service URI MySQL vào DATABASE_URL:
# Ví dụ Aiven: mysql://avnadmin:PASSWORD@mysql-xxx.aivencloud.com:12345/defaultdb?ssl-mode=REQUIRED
DATABASE_URL=

# Cách 2: Cấu hình từng thông số MySQL rời (Nếu không dùng DATABASE_URL)
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=ac_rms_db
DB_SSL=false

# Tự động khởi tạo 27 bảng 3NF và nạp dữ liệu mẫu nếu CSDL trống
AUTO_INIT_DB=true

# Khóa bí mật ký JWT (HMAC-SHA256) cho đăng nhập phân quyền RBAC (bắt buộc đặt chuỗi ngẫu nhiên dài khi chạy production)
JWT_SECRET=
